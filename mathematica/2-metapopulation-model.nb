      RowBox[{"c", "[", "3", "]"}], ",", 
      RowBox[{"c", "[", "4", "]"}], ",", 
      RowBox[{"c", "[", "5", "]"}], ",", "pVal"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"solution", "=", 
  RowBox[{"NSolve", "[", 
   RowBox[{"target", ",", "unknowns"}], "]"}]}]}], "Input",
