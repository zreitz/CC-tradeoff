              RowBox[{"\[Alpha]", " ", "\[Epsilon]", " ", 
               RowBox[{"M", "[", "t", "]"}]}]}], ")"}]}]}], ")"}], "2"]}]]}], 
     RowBox[{"2", " ", "kf"}]], ";"}], "\n", 
   RowBox[{
    RowBox[{"eq", " ", "=", " ", 
     RowBox[{"0", "==", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Alpha]"}], ")"}], "\[Gamma]", " ", "vh", " ", 
          RowBox[{"Qstar", "/", " ", 
           RowBox[{"(", 
            RowBox[{
