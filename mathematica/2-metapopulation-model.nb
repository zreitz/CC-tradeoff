Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "GenerateLevinsEq", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GenerateLevinsEq", "[", "N_", "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"c", ",", "p", ",", "m"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"0", " ", "==", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"c", "[", "i", "]"}], "*", 
         RowBox[{"p", "[", "i", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
