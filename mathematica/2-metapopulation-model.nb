Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", " ", "=", " ", 
   RowBox[{
    RowBox[{"Biomass", "[", "0", "]"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"windowmax", "=", "0.15"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plt1", "=", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"RegionPlot", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"res", "=", 
            RowBox[{"Biomass", "[", "\[Alpha]1", "]"}]}], ",", 
           RowBox[{"inv", "=", 
            RowBox[{"Biomass", "[", "\[Alpha]2", "]"}]}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"inv", ">", "m"}], " ", "&&", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Alpha]2", "<", "\[Alpha]1"}], "||", 
            RowBox[{"res", "<", "m"}]}], ")"}]}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]1", ",", "0", ",", "windowmax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]2", ",", "0", ",", "windowmax"}], "}"}], ",", 
       RowBox[{"PlotPoints", "->", "50"}], ",", 
       RowBox[{"PlotRangePadding", "->", "None"}], ",", "\[IndentingNewLine]", 
       RowBox[{"BoundaryStyle", "->", "None"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"RGBColor", "[", "\"\<#000000\>\"", "]"}]}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"None", ",", "\"\<\[Alpha]_inv\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<\[Mu] = \[Delta](0)/2\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Epilog", "->", 
        RowBox[{"{", 
         RowBox[{"Black", ",", " ", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "1"}], "}"}]}], "}"}], "]"}]}], " ", 
         "}"}]}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"RegionPlot", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"res", "=", 
            RowBox[{"Biomass", "[", "\[Alpha]1", "]"}]}], ",", 
           RowBox[{"inv", "=", 
            RowBox[{"Biomass", "[", "\[Alpha]2", "]"}]}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"res", ">", "m"}], " ", "&&", " ", 
          RowBox[{"inv", " ", ">", " ", "m"}], " ", "&&", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"res", ">", 
             RowBox[{
              RowBox[{"inv", "^", "2"}], "/", "m"}]}], "||", 
            RowBox[{"inv", ">", 
             RowBox[{
              RowBox[{"res", "^", "2"}], "/", "m"}]}]}], ")"}]}]}], "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]1", ",", "0", ",", "windowmax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]2", ",", "0", ",", "windowmax"}], "}"}], ",", 
       RowBox[{"PlotPoints", "->", "50"}], ",", 
       RowBox[{"PlotRangePadding", "->", "None"}], ",", "\[IndentingNewLine]", 
       RowBox[{"BoundaryStyle", "->", "None"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"RGBColor", "[", "\"\<#777777\>\"", "]"}]}]}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"Biomass", "[", "0", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"plt2", "=", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"RegionPlot", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"res", "=", 
            RowBox[{"Biomass", "[", "\[Alpha]1", "]"}]}], ",", 
           RowBox[{"inv", "=", 
            RowBox[{"Biomass", "[", "\[Alpha]2", "]"}]}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"inv", ">", "m"}], " ", "&&", " ", 
          RowBox[{"(", 
