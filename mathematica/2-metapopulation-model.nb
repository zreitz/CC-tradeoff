Cell[CellGroupData[{

Cell["Metapopulation", "Subsection",
 CellChangeTimes->{{3.9917492324671135`*^9, 
  3.991749233879925*^9}},ExpressionUUID->"dab0c877-1cf2-4743-a043-\
f4a68f83b31b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Generate", " ", "ODEs", " ", "for", " ", 
     RowBox[{"Hastings", "'"}], " ", "formulation", " ", "of", " ", 
     "Levins"}], "-", 
    RowBox[{"Culver", " ", "metapopulation", " ", "model"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "GenerateLevins", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GenerateLevins", "[", "N_", "]"}], ":=", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"c", ",", "p", ",", "m"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"p", "[", "i", "]"}], "'"}], "[", "t", "]"}], " ", "==", 
         " ", 
         RowBox[{
          RowBox[{
           RowBox[{"c", "[", "i", "]"}], "*", 
           RowBox[{
            RowBox[{"p", "[", "i", "]"}], "[", "t", "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"p", "[", "j", "]"}], "[", "t", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "i"}], "}"}]}], "]"}]}], ")"}]}], "-", 
          RowBox[{"m", "*", 
           RowBox[{
            RowBox[{"p", "[", "i", "]"}], "[", "t", "]"}]}], "-", 
          RowBox[{
           RowBox[{
            RowBox[{"p", "[", "i", "]"}], "[", "t", "]"}], "*", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"c", "[", "j", "]"}], "*", 
              RowBox[{
               RowBox[{"p", "[", "j", "]"}], "[", "t", "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}]}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "N"}], "}"}]}], "]"}]}], ")"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Numerically", " ", "solve", " ", "the", " ", "Levins", " ", "model", 
      " ", "for", " ", "given", " ", "dispersals"}], ",", " ", 
     RowBox[{"mortality", " ", "rate"}], ",", " ", 
     RowBox[{"and", " ", "initial", " ", "values"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "SolveLevins", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SolveLevins", "[", 
      RowBox[{"dispersals_", ",", "mort_", ",", 
       RowBox[{"start_", ":", "0.1"}], ",", 
       RowBox[{"maxT_", ":", "1000"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"size", "=", 
          RowBox[{"Length", "[", "dispersals", "]"}]}], ",", 
         "\[IndentingNewLine]", "starts", ",", "\[IndentingNewLine]", 
         RowBox[{"endT", "=", "maxT"}], ",", "\[IndentingNewLine]", "sol"}], 
        "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Clear", "[", 
         RowBox[{"c", ",", "p", ",", "m"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"starts", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"NumericQ", "[", "start", "]"}], ",", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"start", ",", "size"}], "]"}], ",", "start"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"size", "!=", 
           RowBox[{"Length", "[", "starts", "]"}]}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", "\"\<Vectors are of unequal size!\>\"", "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"GenerateLevins", "[", "size", "]"}], " ", ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Thread", "[", 
                RowBox[{
                 RowBox[{"Array", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"p", "[", "#", "]"}], "[", "0", "]"}], "&"}], ",",
                    "size"}], "]"}], "==", "starts"}], "]"}]}], "}"}], 
             "\[IndentingNewLine]", "/.", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"Array", "[", 
                RowBox[{"c", ",", "size"}], "]"}], "->", "dispersals"}], 
              "]"}]}], "/.", 
            RowBox[{"m", "->", "mort"}]}], " ", ",", "\[IndentingNewLine]", 
           RowBox[{"Array", "[", 
            RowBox[{"p", ",", "size"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "maxT"}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Association", "[", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{"sol", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"\"\<end\>\"", "->", "endT"}]}], "]"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.933167626278661*^9, 3.933167651946562*^9}, {
   3.933168564952165*^9, 3.933168565128599*^9}, 3.934892499177381*^9, {
   3.934892575792803*^9, 3.934892579200067*^9}, {3.93489341040695*^9, 
   3.934893411638286*^9}, {3.9409611822134285`*^9, 3.94096118253174*^9}, {
   3.946235213311508*^9, 3.946235235562233*^9}, 3.946235505419805*^9, 
   3.9462357666649857`*^9, {3.963073936591975*^9, 3.9630740919856586`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"bb27f9d2-58f1-7d4e-ad53-03a658cdc301"]
}, Open  ]]
}, Open  ]],

