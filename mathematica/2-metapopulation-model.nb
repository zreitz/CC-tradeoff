Cell[CellGroupData[{

Cell["Niche shadow plot generation (Figure 3B)", "Section",
 CellChangeTimes->{{3.963074281880514*^9, 3.963074288139942*^9}, {
  3.963074418955635*^9, 3.963074448442627*^9}, {3.9917582434354477`*^9, 
  3.991758248949917*^9}},ExpressionUUID->"6b9885d8-f05c-1c40-922e-\
544fa38e4212"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"alphamin", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alphamax", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FindEq", "[", 
   RowBox[{"strains_", ",", " ", "mortality_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"strats", "=", 
       RowBox[{"Sort", "[", "strains", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"threshold", "=", "mortality"}], ",", "\[IndentingNewLine]", 
      RowBox[{"survivors", "=", 
       RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"freqs", "=", 
       RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"biomasses", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"shadowthresholds", "=", 
       RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"invaderregion", "=", 
       RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"shadowregion", "=", 
       RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "c", ",", "freq", 
      ",", "newthresh", ",", "strat"}], "\[IndentingNewLine]", "}"}], ",", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"c", " ", "=", " ", 
          RowBox[{"Biomass", "[", 
           RowBox[{"strats", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"c", " ", ">", " ", "threshold"}], ",", " ", 
           RowBox[{"(", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"freq", " ", "=", " ", 
              RowBox[{"1", "-", 
               RowBox[{"Total", "[", "freqs", "]"}], "-", 
               RowBox[{"mortality", "/", "c"}], "-", 
               RowBox[{
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"biomasses", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "*", 
                   RowBox[{"freqs", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"j", ",", 
                    RowBox[{"Length", "[", "biomasses", "]"}]}], "}"}]}], 
                 "]"}], "/", "c"}]}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"survivors", ",", 
               RowBox[{"strats", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"biomasses", ",", "c"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"freqs", ",", " ", "freq"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"strat", "=", 
              RowBox[{"Strategy", "[", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"c", "*", "threshold"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"strat", "===", "None"}], ",", 
               RowBox[{"strat", "=", "alphamin"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"invaderregion", ",", 
               RowBox[{"{", 
                RowBox[{"strat", ",", 
                 RowBox[{"strats", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"threshold", "=", 
              RowBox[{
               RowBox[{"c", "^", "2"}], "/", "threshold"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"shadowthresholds", ",", "threshold"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"strat", "=", 
              RowBox[{"Strategy", "[", "threshold", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"strat", "===", "None"}], ",", 
               RowBox[{"strat", "=", "alphamax"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"shadowregion", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"strats", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "strat"}], "}"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"strat", "=", 
              RowBox[{"Strategy", "[", 
               RowBox[{"threshold", ",", " ", "True"}], "]"}]}], ";", " ", 
             RowBox[{"(*", " ", 
              RowBox[{
              "Also", " ", "get", " ", "high", " ", "strat", " ", "shadow"}], 
              " ", "*)"}], "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"strat", "===", "None"}], ",", "Null", ",", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"shadowregion", ",", 
                 RowBox[{"{", 
                  RowBox[{"strat", ",", "alphamax"}], "}"}]}], "]"}]}], "]"}],
              ";"}], "\[IndentingNewLine]", ")"}]}], "]"}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "strains", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<strains\>\"", "->", "survivors"}], ",", 
        RowBox[{"\"\<freqs\>\"", "->", "freqs"}], ",", 
        RowBox[{"\"\<biomasses\>\"", "->", "biomasses"}], ",", " ", 
        RowBox[{"\"\<mortality\>\"", " ", "->", "mortality"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<shadow_threshold\>\"", "->", "shadowthresholds"}], ",", 
        RowBox[{"\"\<replaced_by\>\"", "->", "invaderregion"}], ",", 
        RowBox[{"\"\<replaces\>\"", "->", "shadowregion"}]}], "|>"}]}], 
     "\[IndentingNewLine]", ")"}]}], "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.934892602234869*^9, 3.934892624035944*^9}, {
