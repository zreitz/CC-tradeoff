Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Default", " ", "parameters"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "defaults", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"defaults", "=", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sFe", "->", "5"}], ",", "\[IndentingNewLine]", 
       RowBox[{"sApo", "->", "1"}], ",", "\[IndentingNewLine]", 
       RowBox[{"d", "->", "1"}], ",", "\[IndentingNewLine]", 
       RowBox[{"dm", "->", "0.1"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"kf", "->", "1"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\[Gamma]", "->", "3"}], ",", "\[IndentingNewLine]", 
       RowBox[{"vh", "->", "10"}], ",", 
       RowBox[{"Kh", "->", "1"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\[Epsilon]", "->", "1."}]}], "\[IndentingNewLine]", "}"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"In", "-", 
     RowBox[{"patch", " ", "solution"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a", "=", "kf"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b", "=", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"kf", " ", 
         RowBox[{"(", 
          RowBox[{"sFe", " ", "+", " ", 
           RowBox[{"\[Epsilon]", " ", "\[Alpha]", " ", 
            RowBox[{"M", " ", "[", "t", "]"}]}], "+", " ", "sApo"}], ")"}]}], 
        " ", "+", " ", 
        RowBox[{"d", "^", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c", "=", 
     RowBox[{"kf", " ", "sFe", " ", 
      RowBox[{"(", " ", 
       RowBox[{
        RowBox[{"\[Epsilon]", " ", "\[Alpha]", " ", 
         RowBox[{"M", "[", "t", "]"}]}], " ", "+", " ", "sApo"}], ")"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Qstar", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "b"}], " ", "-", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"b", "^", "2"}], "-", 
          RowBox[{"4", " ", "a", " ", "c"}]}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "a"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["d", "2"], "+", 
      RowBox[{"kf", " ", 
       RowBox[{"(", 
        RowBox[{"sApo", "+", "sFe", "+", 
         RowBox[{"\[Alpha]", " ", "\[Epsilon]", " ", 
          RowBox[{"M", "[", "t", "]"}]}]}], ")"}]}], "-", 
      SqrtBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", "4"}], " ", 
         SuperscriptBox["kf", "2"], " ", "sFe", " ", 
         RowBox[{"(", 
          RowBox[{"sApo", "+", 
           RowBox[{"\[Alpha]", " ", "\[Epsilon]", " ", 
            RowBox[{"M", "[", "t", "]"}]}]}], ")"}]}], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
