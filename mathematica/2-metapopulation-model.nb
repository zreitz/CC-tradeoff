Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "GenerateLevinsEq", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"GenerateLevinsEq", "[", "N_", "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"c", ",", "p", ",", "m"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"0", "==", 
       RowBox[{
        RowBox[{
         RowBox[{"c", "[", "i", "]"}], "*", 
         RowBox[{"p", "[", "i", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"p", "[", "j", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "i"}], "}"}]}], "]"}]}], ")"}]}], "-", 
        RowBox[{"m", "*", 
         RowBox[{"p", "[", "i", "]"}]}], "-", 
        RowBox[{
         RowBox[{"p", "[", "i", "]"}], "*", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"c", "[", "j", "]"}], "*", 
            RowBox[{"p", "[", "j", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}]}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "N"}], "}"}]}], "]"}]}], ")"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sixstrain", "=", 
    RowBox[{"GenerateLevinsEq", "[", "6", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"target", "=", 
    RowBox[{
     RowBox[{"sixstrain", "/.", " ", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"p", "[", "#", "]"}], "->", "pVal"}], "&"}], ",", 
        RowBox[{"Range", "[", "6", "]"}]}], "]"}]}], "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "->", 
        RowBox[{"Biomass", "[", "0", "]"}]}], ",", 
       RowBox[{
        RowBox[{"c", "[", "6", "]"}], "->", 
        RowBox[{"Biomass", "[", "alphahat", "]"}]}]}], "}"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"unknowns", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "[", "1", "]"}], ",", 
