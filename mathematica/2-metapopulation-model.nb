     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "x", "}"}], ",", 
       RowBox[{"(", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"bio", ">", 
            RowBox[{"Biomass", "[", "alphahat", "]"}]}], ",", 
           RowBox[{"Return", "[", "None", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"high", ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"xmin", "=", "alphahat"}], ";", 
