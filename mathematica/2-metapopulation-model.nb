               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  SuperscriptBox["d", "2"]}], "-", 
                 RowBox[{"kf", " ", 
                  RowBox[{"(", 
                   RowBox[{"sApo", "+", "sFe", "+", 
                    RowBox[{"\[Alpha]", " ", "\[Epsilon]", " ", 
                    RowBox[{"M", "[", "t", "]"}]}]}], ")"}]}]}], ")"}], 
               "2"]}]]}], ")"}]}], 
         RowBox[{"2", " ", "kf", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"d", " ", "Kh"}], "+", 
            RowBox[{"vh", " ", 
             RowBox[{"M", "[", "t", "]"}]}]}], ")"}]}]]}], ")"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"numSol", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Evaluate", "[", "eq", "]"}], "/.", "defaults"}], ",", " ", 
