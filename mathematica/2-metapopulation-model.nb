     "root"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", "Biomass", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Biomass", "[", 
     RowBox[{"a_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"a", " ", "==", " ", "0"}], ",", " ", 
        RowBox[{"Return", "[", "Mzero", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "candidates", "}"}], ",", 
        RowBox[{
         RowBox[{"candidates", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"M", "[", "t", "]"}], "/.", " ", "numSol"}], "/.", " ", 
             RowBox[{"\[Alpha]", "->", "a"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
              RowBox[{
               RowBox[{"Im", "[", "#", "]"}], "==", "0"}], "&&", 
              RowBox[{
               RowBox[{"Re", "[", "#", "]"}], ">", "0"}]}], "&"}]}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "candidates", "]"}], "==", "0"}], ",", "0",
            ",", 
           RowBox[{"Re", "[", 
            RowBox[{"First", "[", "candidates", "]"}], "]"}]}], "]"}]}]}], 
       "]"}]}], "\[IndentingNewLine]", ")"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"alphahat", " ", "maximizes", " ", "biomass"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alphahat", "=", 
