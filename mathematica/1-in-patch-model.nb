        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"NumericQ", "[", "start", "]"}], ",", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"start", ",", "size"}], "]"}], ",", "start"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"size", "!=", 
          RowBox[{"Length", "[", "starts", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<Vectors are of unequal size!\>\"", "]"}],
           ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"odes", "=", 
        RowBox[{"GenerateSidModel", "[", "size", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"stateVars", "=", 
        RowBox[{"Array", "[", 
         RowBox[{"M", ",", "size"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"conditions", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"params", ",", "defaults"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"method", "=", 
        RowBox[{"If", "[", 
         RowBox[{"stop", ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"\"\<EventLocator\>\"", ",", "\[IndentingNewLine]", 
            RowBox[{"\"\<Event\>\"", "->", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{"Map", "[", 
                 RowBox[{"First", ",", "odes"}], "]"}], "]"}], "]"}], ">", 
              RowBox[{"10", "^", 
               RowBox[{"-", "6"}]}]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"\"\<EventAction\>\"", ":>", 
             RowBox[{"Throw", "[", 
              RowBox[{
               RowBox[{"endT", "=", " ", "t"}], ",", 
               "\"\<StopIntegration\>\""}], "]"}]}]}], "}"}], ",", 
          "\[IndentingNewLine]", "Automatic"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{"odes", ",", "\[IndentingNewLine]", 
              RowBox[{"Thread", "[", 
               RowBox[{
                RowBox[{"Array", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"M", "[", "#", "]"}], "[", "0", "]"}], "&"}], ",",
                   "size"}], "]"}], "==", "starts"}], "]"}]}], 
             "\[IndentingNewLine]", "}"}], "//.", "conditions"}], "//.", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Array", "[", 
              RowBox[{"\[Alpha]", ",", "size"}], "]"}], "->", "alphas"}], 
            "]"}]}], ",", "\[IndentingNewLine]", "stateVars", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "maxT"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Method", "->", "method"}]}], "\[IndentingNewLine]", 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Association", "[", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"sol", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"\"\<end\>\"", "->", "endT"}]}], "]"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Fstar", "[", 
