Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Mstar", "[", "a_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"a", "==", "0"}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{"Mzero", "/.", "defaults"}], ",", "\[IndentingNewLine]", 
     RowBox[{"First", "@", 
      RowBox[{"Select", "[", "\n", "  ", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"M", "[", "t", "]"}], " ", "/.", " ", 
           RowBox[{"(", 
            RowBox[{"sols", " ", "/.", " ", "defaults"}], ")"}]}], "/.", 
          RowBox[{"\[Alpha]", "->", "a"}]}], "]"}], ",", " ", "\n", "  ", 
        RowBox[{"Function", "[", 
         RowBox[{"Mval", ",", " ", 
          RowBox[{
           RowBox[{"Mval", " ", ">", " ", "0"}], " ", "&&", " ", 
           RowBox[{"NumericQ", "[", "Mval", "]"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Im", "[", "Mval", "]"}], " ", "==", " ", "0"}]}]}], 
         "]"}]}], "\n", "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Mstar", "[", "0", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Mstar", "[", "0.01", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Mstar", "[", "0.1", "]"}]}], "Input",
