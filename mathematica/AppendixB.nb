 RowBox[{
  RowBox[{"numSols", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"sols", "/.", "defaults"}], ",", " ", 
     RowBox[{"Assumptions", "->", "limits"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.963070314900736*^9, 3.963070361786297*^9}, {
