               RowBox[{
                SuperscriptBox["kf", "2"], " ", 
                SuperscriptBox["sFe", "2"]}]}]], 
             RowBox[{"2", " ", "d", " ", "kf"}]]}], ")"}]}]}], ")"}]}]]}], 
    ",", 
    RowBox[{"Fe", "\[Rule]", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"-", 
