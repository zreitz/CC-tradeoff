Cell[CellGroupData[{

Cell["Stability of the solutions for these parameters", "Subsection",
 CellChangeTimes->{{3.963070100633333*^9, 3.9630701036373234`*^9}, {
  3.9630704186194134`*^9, 
  3.96307042420212*^9}},ExpressionUUID->"13ed342f-0cfc-7248-8b9b-\
