Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"extinction", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"eqs", "/.", 
      RowBox[{
       RowBox[{"M", "[", "1", "]"}], "->", "0"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"Apo", ",", "Holo", ",", "Fe"}], "}"}], ",", "NonNegativeReals", 
    ",", "\[IndentingNewLine]", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0", "<=", 
        RowBox[{"\[Alpha]", "[", "1", "]"}], "<=", "1"}], ",", 
       RowBox[{"0", "<=", "\[Rho]", "<=", "1"}], ",", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", ">", "0"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "vh", ",", "\[Gamma]", ",", "Kh", ",", "\[Epsilon]", ",", "d", ",", 
           "sFe", ",", "kf", ",", "sApo"}], "}"}]}], "]"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
