Cell[TextData[{
 "Growth depends on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "holo"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "440dae18-3338-aa48-b774-4317a674face"],
 " - strain with the lowest equilibrium value will replace all others"
}], "Text",
 CellChangeTimes->{{3.9630723193870144`*^9, 
  3.963072347268404*^9}},ExpressionUUID->"1ae0a95d-a75d-c94e-a101-\
0e6f359ac742"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Rholo", "[", "a_", "]"}], ":=", 
   RowBox[{
    RowBox[{"d", "*", 
     RowBox[{"Kh", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"vh", "*", "\[Gamma]", "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", "a"}], ")"}]}], "-", "d"}], ")"}]}]}], "/.", 
    "defaults"}]}], ";"}]], "Input",
 CellLabel->
  "In[120]:=",ExpressionUUID->"0f7a8c7b-e91f-6141-9d3b-0a3a42fb8b46"],

