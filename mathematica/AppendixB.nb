Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "GenerateSidModel", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GenerateSidModel", "[", "N_", "]"}], ":=", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"biomass", ":", " ", 
         RowBox[{"growth", " ", "-", " ", "washout"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"M", "[", "i", "]"}], "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{
             RowBox[{"Growth", "[", 
              RowBox[{
               RowBox[{"\[Alpha]", "[", "i", "]"}], ",", 
               RowBox[{"Holo", "[", "t", "]"}]}], "]"}], "*", 
             RowBox[{
              RowBox[{"M", "[", "i", "]"}], "[", "t", "]"}]}], "-", 
            RowBox[{"d", "*", 
             RowBox[{
              RowBox[{"M", "[", "i", "]"}], "[", "t", "]"}]}]}]}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "N"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Apo", ":", " ", 
          RowBox[{
          "production", " ", "+", " ", "recycling", " ", "-", " ", 
           "chelation", " ", "-", " ", "washout"}]}], "  ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Apo", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"sApo", "+", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"M", "[", "j", "]"}], "[", "t", "]"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Alpha]", "[", "j", "]"}], "*", "\[Epsilon]"}], "+", 
               RowBox[{
                RowBox[{"HoloFlux", "[", 
                 RowBox[{"Holo", "[", "t", "]"}], "]"}], "*", "\[Rho]"}]}], 
              ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "N"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
          "-", 
          RowBox[{"Chelation", "[", 
           RowBox[{
            RowBox[{"Apo", "[", "t", "]"}], ",", 
            RowBox[{"Fe", "[", "t", "]"}]}], "]"}], "-", 
          RowBox[{"d", "*", 
           RowBox[{"Apo", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Holo", ":", " ", 
          RowBox[{
          "chelation", " ", "-", " ", "uptake", " ", "-", " ", "washout"}]}], 
         "  ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Holo", "'"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{"Chelation", "[", 
           RowBox[{
            RowBox[{"Apo", "[", "t", "]"}], ",", 
            RowBox[{"Fe", "[", "t", "]"}]}], "]"}], "-", 
          RowBox[{
           RowBox[{"HoloFlux", "[", 
            RowBox[{"Holo", "[", "t", "]"}], "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"M", "[", "j", "]"}], "[", "t", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "N"}], "}"}]}], "]"}], ")"}]}], "-", 
          RowBox[{"d", "*", 
           RowBox[{"Holo", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Fe", ":", " ", 
          RowBox[{
          "supply", " ", "-", " ", "chelation", " ", "-", " ", "private", " ",
            "-", " ", "washout"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Fe", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"sFe", "-", 
          RowBox[{"Chelation", "[", 
           RowBox[{
            RowBox[{"Apo", "[", "t", "]"}], ",", 
            RowBox[{"Fe", "[", "t", "]"}]}], "]"}], "-", 
          RowBox[{"d", "*", 
           RowBox[{"Fe", "[", "t", "]"}]}]}]}]}], "\[IndentingNewLine]", 
       "}"}], "]"}], "\[IndentingNewLine]", ")"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"Chelation", ",", "HoloFlux", ",", " ", "Growth"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Chelation", "[", 
    RowBox[{"apo_", ",", "fe_"}], "]"}], ":=", 
   RowBox[{"kf", "*", "apo", "*", "fe"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HoloFlux", "[", "holo_", "]"}], ":=", " ", 
   RowBox[{"vh", "*", 
    RowBox[{"holo", "/", 
     RowBox[{"(", 
      RowBox[{"Kh", "+", "holo"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Growth", "[", 
    RowBox[{"alpha_", ",", " ", "holo_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "alpha"}], ")"}], "*", "\[Gamma]", "*", 
    RowBox[{"HoloFlux", "[", "holo", "]"}]}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.929184049005745*^9, 3.929184101029896*^9}, {
  3.9291841384421806`*^9, 3.929184411159807*^9}, {3.929184478735412*^9, 
  3.92918452205769*^9}, {3.929184689330261*^9, 3.929184696130289*^9}, {
