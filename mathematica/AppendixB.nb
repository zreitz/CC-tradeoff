             SuperscriptBox["kf", "2"], " ", 
             SuperscriptBox["sFe", "2"]}]}]], 
          RowBox[{"2", " ", "d", " ", "kf"}]]}], ")"}]}], 
      RowBox[{"d", " ", 
       RowBox[{"(", 
        RowBox[{"d", "+", 
         RowBox[{"kf", " ", 
          RowBox[{"(", 
