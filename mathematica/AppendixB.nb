Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"lines", "=", 
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"M", "[", "1", "]"}], "/.", 
      RowBox[{"(", 
       RowBox[{"sols", "/.", "defaults"}], ")"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Split", " ", "function", " ", "so", " ", "it", " ", "can", " ", "be", " ",
     "colored", " ", "differently"}], " ", "*)"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stable", "=", 
   RowBox[{"lines", "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lines", "[", 
    RowBox[{"[", "3", "]"}], "]"}], "=", 
   RowBox[{"ConditionalExpression", "[", 
    RowBox[{"stable", ",", 
     RowBox[{
      RowBox[{"\[Alpha]", "[", "1", "]"}], ">", "0.227"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
