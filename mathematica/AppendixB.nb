      RowBox[{
       RowBox[{"0", "<=", 
        RowBox[{"\[Alpha]", "[", "1", "]"}], "<=", "1"}], ",", 
       RowBox[{"0", "<=", "\[Rho]", "<=", "1"}], ",", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", ">", "0"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "vh", ",", "\[Gamma]", ",", "Kh", ",", "\[Epsilon]", ",", "d", ",", 
           "sFe", ",", "kf", ",", "sApo"}], "}"}]}], "]"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
