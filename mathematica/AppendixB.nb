Cell[CellGroupData[{

Cell["Representative Dynamics (Figure 1A and D)", "Section",
 CellChangeTimes->{{3.930328400243656*^9, 3.9303284013679695`*^9}, {
  3.9630723790318604`*^9, 
  3.9630723931138744`*^9}},ExpressionUUID->"05728827-9890-094f-9f36-\
c312d422725e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "SolvePatch", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SolvePatch", "[", 
    RowBox[{"alphas_", ",", 
     RowBox[{"start_", ":", "1"}], ",", 
     RowBox[{"params_", ":", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"maxT_", ":", "1000"}], ",", 
     RowBox[{"stop_", ":", "True"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"size", "=", 
        RowBox[{"Length", "[", "alphas", "]"}]}], ",", "\[IndentingNewLine]", 
       "starts", ",", "\[IndentingNewLine]", "odes", ",", 
       "\[IndentingNewLine]", "stateVars", ",", "\[IndentingNewLine]", 
       "conditions", ",", "\[IndentingNewLine]", "method", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"endT", "=", "maxT"}], ",", "\[IndentingNewLine]", "sol"}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{
       "M", ",", "Apo", ",", "Holo", ",", "Fe", ",", "t", ",", "\[Alpha]", 
        ",", "apoStart", ",", "holoStart", ",", "feStart"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"starts", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"NumericQ", "[", "start", "]"}], ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"start", ",", "size"}], "]"}], ",", "start"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"size", "!=", 
         RowBox[{"Length", "[", "starts", "]"}]}], ",", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<Vectors are of unequal size!\>\"", "]"}], 
         ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"odes", "=", 
       RowBox[{"GenerateSidModel", "[", "size", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"stateVars", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Array", "[", 
           RowBox[{"M", ",", "size"}], "]"}], ",", "Apo", ",", "Holo", ",", 
          "Fe"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"conditions", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"params", ",", "defaults"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"method", "=", 
       RowBox[{"If", "[", 
        RowBox[{"stop", ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\"\<EventLocator\>\"", ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<Event\>\"", "->", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{"Map", "[", 
                RowBox[{"First", ",", "odes"}], "]"}], "]"}], "]"}], ">", 
             RowBox[{"10", "^", 
              RowBox[{"-", "6"}]}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<EventAction\>\"", ":>", 
            RowBox[{"Throw", "[", 
             RowBox[{
              RowBox[{"endT", "=", " ", "t"}], ",", 
              "\"\<StopIntegration\>\""}], "]"}]}]}], "}"}], ",", 
         "\[IndentingNewLine]", "Automatic"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{"odes", ",", "\[IndentingNewLine]", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"Array", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"M", "[", "#", "]"}], "[", "0", "]"}], "&"}], ",", 
                 "size"}], "]"}], "==", "starts"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Apo", "[", "0", "]"}], "==", "apoStart"}], ",", 
             RowBox[{
              RowBox[{"Holo", "[", "0", "]"}], "==", "holoStart"}], ",", 
             RowBox[{
              RowBox[{"Fe", "[", "0", "]"}], "==", "feStart"}]}], 
            "\[IndentingNewLine]", "}"}], "//.", "conditions"}], "//.", 
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Array", "[", 
             RowBox[{"\[Alpha]", ",", "size"}], "]"}], "->", "alphas"}], 
           "]"}]}], ",", "\[IndentingNewLine]", "stateVars", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "maxT"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Method", "->", "method"}]}], "\[IndentingNewLine]", "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Association", "[", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"sol", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"\"\<end\>\"", "->", "endT"}]}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.930328432745596*^9, 3.930328433653813*^9}, {
   3.930329728119355*^9, 3.930329740735014*^9}, {3.930329969713661*^9, 
