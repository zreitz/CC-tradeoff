Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "d"}], " ", 
     RowBox[{"M", "[", "1", "]"}]}], "+", 
    FractionBox[
     RowBox[{"Holo", " ", "vh", " ", "\[Gamma]", " ", 
      RowBox[{"M", "[", "1", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"\[Alpha]", "[", "1", "]"}]}], ")"}]}], 
     RowBox[{"Holo", "+", "Kh"}]]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "Apo"}], " ", "d"}], "-", 
    RowBox[{"Apo", " ", "Fe", " ", "kf"}], "+", "sApo", "+", 
    RowBox[{
     RowBox[{"M", "[", "1", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"Holo", " ", "vh", " ", "\[Rho]"}], 
        RowBox[{"Holo", "+", "Kh"}]], "+", 
       RowBox[{"\[Epsilon]", " ", 
        RowBox[{"\[Alpha]", "[", "1", "]"}]}]}], ")"}]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "d"}], " ", "Holo"}], "+", 
    RowBox[{"Apo", " ", "Fe", " ", "kf"}], "-", 
    FractionBox[
     RowBox[{"Holo", " ", "vh", " ", 
      RowBox[{"M", "[", "1", "]"}]}], 
     RowBox[{"Holo", "+", "Kh"}]]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "d"}], " ", "Fe"}], "-", 
    RowBox[{"Apo", " ", "Fe", " ", "kf"}], "+", "sFe"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.929203993460951*^9, 3.9292040015997906`*^9}, 
