Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Apo", "\[Rule]", 
     FractionBox["sApo", 
      RowBox[{"d", "+", 
       RowBox[{"kf", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox["d", "2"]}], "-", 
            RowBox[{"kf", " ", "sApo"}], "+", 
            RowBox[{"kf", " ", "sFe"}]}], 
           RowBox[{"2", " ", "d", " ", "kf"}]], "+", 
          FractionBox[
           SqrtBox[
            RowBox[{
             SuperscriptBox["d", "4"], "+", 
             RowBox[{"2", " ", 
              SuperscriptBox["d", "2"], " ", "kf", " ", "sApo"}], "+", 
             RowBox[{
              SuperscriptBox["kf", "2"], " ", 
              SuperscriptBox["sApo", "2"]}], "+", 
             RowBox[{"2", " ", 
              SuperscriptBox["d", "2"], " ", "kf", " ", "sFe"}], "-", 
             RowBox[{"2", " ", 
              SuperscriptBox["kf", "2"], " ", "sApo", " ", "sFe"}], "+", 
             RowBox[{
              SuperscriptBox["kf", "2"], " ", 
              SuperscriptBox["sFe", "2"]}]}]], 
           RowBox[{"2", " ", "d", " ", "kf"}]]}], ")"}]}]}]]}], ",", 
    RowBox[{"Holo", "\[Rule]", 
     FractionBox[
      RowBox[{"kf", " ", "sApo", " ", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"-", 
