      RowBox[{"eqs", "/.", 
       RowBox[{
        RowBox[{"M", "[", "1", "]"}], "->", "0"}]}], "/.", 
      RowBox[{"sApo", "->", "0"}]}], "]"}], ",", 
    RowBox[{"{", 
